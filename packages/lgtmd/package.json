{
  "name": "lgtmd",
  "version": "0.1.0",
  "description": "Code-authored documents compiled by lgtmd's shared Rust engine",
  "homepage": "https://github.com/lgtmd/lgtmd",
  "bugs": {
    "url": "https://github.com/lgtmd/lgtmd/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lgtmd/lgtmd.git",
    "directory": "packages/lgtmd"
  },
  "bin": {
    "lgtmd": "./dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "native",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./playwright": {
      "types": "./dist/src/playwright/index.d.ts",
      "import": "./dist/src/playwright/index.js"
    },
    "./playwright/reporter": "./dist/src/playwright/reporter.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true,force:true})\" && tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/src/cli.js', 0o755)\"",
    "test": "node --test dist/tests/*.test.js"
  },
  "peerDependencies": {
    "@playwright/test": "1.64.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24 <25"
  }
}
