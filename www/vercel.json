{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci --workspaces=false",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  }
}
